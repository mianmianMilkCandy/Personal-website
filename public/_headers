# 静态托管的响应头（Netlify / Cloudflare Pages / 部分对象存储会读这个文件）
# ---------------------------------------------------------------------------
# 为什么需要它：CSP 由 <meta http-equiv> 注入（为了兼容无法自定义响应头的
# GitHub Pages），但 meta 形式**做不到**下面这几件事 —— 它们只能是响应头：
#   · frame-ancestors（防点击劫持）—— 规范明确忽略 meta 里的这一条
#   · HSTS、nosniff、Referrer-Policy、Permissions-Policy
# 所以：GitHub Pages 只有 meta 那一层；Netlify / CF Pages / nginx 请用本文件
# 或等价配置补上完整的一层。
#
# nginx 等价写法：
#   add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; media-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'none'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'" always;
#   add_header X-Content-Type-Options "nosniff" always;
#   add_header Referrer-Policy "strict-origin-when-cross-origin" always;
#   add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
#   add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; media-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'none'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# 带内容哈希的产物可以长期强缓存；index.html 与 public/ 下的素材必须每次校验，
# 否则换图/改文案后访客会一直看到旧版本。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
